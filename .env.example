# Qual build é este. Vazio ou false = versão PESSOAL, com tudo ligado.
# true = build PÚBLICO: sem o nicho Siege X e sem a aba Melhorar vídeo — no
# backend as rotas delas deixam de existir, e no frontend o código nem é
# compilado. Lido pelas duas metades (backend/app/features.py e
# frontend/next.config.ts) a partir DESTE arquivo, para não divergirem.
PUBLIC_BUILD=false

# AssemblyAI
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=8192

# Porta do backend. O Makefile e o proxy do frontend leem daqui, então trocar
# neste arquivo basta — não existe segunda cópia para manter em sincronia.
# Fica fora da 8000 de propósito: é a porta padrão de todo projeto FastAPI, e
# um vizinho ocupando ela faz o proxy do frontend cair na API errada.
BACKEND_PORT=8001

# Storage
STORAGE_DIR=./storage

# ── Banco ─────────────────────────────────────────────────────────────────────
# Versão pessoal e testes: SQLite. Build público: Postgres — e ele RECUSA subir
# em SQLite, porque um servidor multiusuário escrevendo num arquivo só corrompe
# sob concorrência. Ver docs/POSTGRES.md para o passo a passo do servidor.
#
#   DATABASE_URL=postgresql+psycopg://clipmint:senha@localhost:5432/clipmint
#
# O driver é o psycopg (psycopg 3): fala síncrono e assíncrono, então serve ao
# app e ao Alembic sem dois drivers para manter.
DATABASE_URL=sqlite+aiosqlite:///./clipmint.db

# Nome antigo da mesma variável. Continua funcionando e, se as duas estiverem
# preenchidas, é ESTA que vence — um .env que já funcionava não muda de banco
# porque a variável nova apareceu. Ou seja: para migrar para o Postgres não
# basta preencher o DATABASE_URL acima, é preciso APAGAR a linha abaixo.
SQLITE_URL=sqlite+aiosqlite:///./clipmint.db

# Banco do build PÚBLICO quando ele roda NESTA máquina, ao lado da versão
# pessoal (`make serve-public`). Existe separado porque o .env é um só para as
# duas versões: pôr o Postgres em DATABASE_URL levaria junto o `make dev`, que
# tem o histórico todo no clipmint.db. No SERVIDOR, onde só existe o build
# público, use o DATABASE_URL acima e deixe esta vazia.
#
#   PUBLIC_DATABASE_URL=postgresql+psycopg://clipmint:senha@localhost:5432/clipmint
PUBLIC_DATABASE_URL=

# Pool de conexões — só vale no Postgres.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ── Mercado Pago (build público) ──────────────────────────────────────────────
# Credenciais do gateway de pagamento. Sem elas o build público sobe, mas
# recusa criar cobrança (503) — dá para desenvolver o resto sem conta no MP.
#
# O access token sai de "Suas integrações > credenciais". Começa com TEST- no
# sandbox e APP_USR- em produção: é a MESMA variável, e é ela que decide contra
# qual ambiente as chamadas vão. Não existe flag separada de sandbox de
# propósito — uma flag discordando do token seria uma forma nova de cobrar de
# verdade achando que era teste.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo da assinatura do webhook, em "Suas integrações > Webhooks >
# Configurar notificação". É a ÚNICA coisa que separa uma notificação do
# gateway de alguém postando "pagamento aprovado" na sua API: sem ele o
# endpoint /api/billing/webhook recusa tudo (e é assim que deve ser).
MERCADOPAGO_WEBHOOK_SECRET=
# Minutos até o QR do Pix expirar.
PIX_EXPIRATION_MINUTES=30
# Endereço público desta instalação, ex.: https://clipmint.com.br
# É para onde o Mercado Pago devolve a pessoa depois de ela autorizar a
# assinatura na página dele. Sem isto, ASSINAR é recusado (503) — mandar alguém
# ao gateway sem caminho de volta a deixaria presa lá com o cartão autorizado.
# A recarga avulsa por Pix NÃO depende desta variável.
PUBLIC_BASE_URL=

# ── Travas de custo (por usuário, janela deslizante) ──────────────────────────
# Transcrição e análise são cobradas por minuto de áudio: sem teto, um bug ou um
# usuário mal-intencionado viram uma fatura que só aparece dias depois.
QUOTA_WINDOW_HOURS=24
# 0 = teto desligado, e é o padrão da versão PESSOAL (uma pessoa, na própria
# conta de API, processando uma live de 6h de propósito). Preencher liga nas
# duas versões. Os dois valem juntos: o que estourar primeiro barra.
QUOTA_MAX_VIDEOS=0
QUOTA_MAX_MINUTES=0
# Tetos usados no build PÚBLICO quando os de cima estão em 0.
PUBLIC_QUOTA_MAX_VIDEOS=10
PUBLIC_QUOTA_MAX_MINUTES=300

# Teto de duração de UM vídeo, conferido ANTES do download. 0 = sem teto
# (padrão da pessoal). Havendo teto, vídeo de duração desconhecida é RECUSADO —
# guarda de custo falha fechado.
MAX_SOURCE_MINUTES=0
PUBLIC_MAX_SOURCE_MINUTES=120

# Jobs processando ao mesmo tempo no servidor. Os demais esperam em "queued".
MAX_CONCURRENT_JOBS=2

# ── Retenção ──────────────────────────────────────────────────────────────────
# Dias até o ARQUIVO do clipe ser apagado. A linha no banco fica: nota, rubrica
# e desempenho real alimentam o few-shot. 0 desliga.
CLIP_TTL_DAYS=14
# O vídeo de origem sai antes: é o que ocupa GB e só serve para re-renderizar.
DOWNLOAD_TTL_DAYS=3
# De quanto em quanto tempo a faxina roda dentro do servidor. 0 = desligada
# (use o cron com `python -m app.scripts.cleanup`).
CLEANUP_INTERVAL_HOURS=6

# Pipeline settings
VIRALITY_THRESHOLD=7.0
MAX_CLIP_DURATION=90
MIN_CLIP_DURATION=15

# Face tracking: true = crop 9:16 segue o rosto; false = crop fixo no centro
FACE_TRACKING_ENABLED=false

# Modo streamer (facecam + gameplay): largura da saída vertical.
# 1080 = Full HD (1080x1920). 2160 gera 4K vertical — arquivo e tempo de render
# muito maiores, só compensa com fonte 1440p+.
STREAMER_OUTPUT_WIDTH=1080

# Zoom da fatia de gameplay. 1.0 = altura cheia da fonte; acima disso fecha o
# enquadramento e afasta a fatia da moldura da facecam.
STREAMER_GAME_ZOOM=1.06

# Marca d'água do clipe: a arte de storage/branding/<nicho>/clip_watermark.png,
# queimada no modo streamer. Largura e altura em frações do canvas; a altura é o
# CENTRO da arte, não o topo. Conta sem o arquivo não ganha marca nenhuma.
CLIP_WATERMARK_WIDTH=0.185
CLIP_WATERMARK_CENTER_Y=0.794
CLIP_WATERMARK_OPACITY=0.70

# Nitidez da facecam depois da ampliação (a cam da fonte é pequena e sobe ~2x).
# 0 desliga; acima de ~1.2 começa a marcar halo em óculos e contorno do cabelo.
FACECAM_SHARPEN=0.8

# ── Contas (build público) ────────────────────────────────────────────────────
# Quanto tempo dura um login, em dias.
SESSION_DAYS=30
# E-mail do usuário-dono. Na versão pessoal é a conta única, dona de todos os
# jobs; no público é quem administra — presets de marca e o painel /admin.
#
# NO PÚBLICO, PREENCHA COM O SEU E-MAIL DE VERDADE. O cadastro público sempre
# cria conta comum (senão qualquer um viraria administrador se cadastrando), e a
# coroa é dada no startup à conta que tiver ESTE e-mail. Deixar o padrão aqui
# significa que ninguém administra o servidor — nem você.
#
# O startup NÃO cria a conta: cadastre-se normalmente com este e-mail e reinicie.
OWNER_EMAIL=dono@clipmint.local
# Tamanho mínimo de senha. Sem exigência de composição de propósito: "1
# maiúscula e 1 símbolo" empurra para senhas curtas e previsíveis.
MIN_PASSWORD_LENGTH=12
# false = ninguém cria conta nova. É o modo para abrir a um grupo fechado.
REGISTRATION_OPEN=true

# Acesso remoto: senha da tela de login do frontend e token da API (header
# X-ClipMint-Token). Vazia = sem checagem, só para uso local.
# No build público ela continua valendo como cerca de perímetro (o proxy do
# Next se identifica com ela), e QUEM É a pessoa vem da sessão.
CLIPMINT_PASSWORD=

# AssemblyAI: modelo de fala. universal-2 (antigo, barato), universal-3-pro,
# universal-3-5-pro (melhor em gíria/grito/áudio sujo). Vazio em LANGUAGE = autodetectar.
ASSEMBLYAI_SPEECH_MODEL=universal-3-pro
ASSEMBLYAI_LANGUAGE=pt

# ── Provedor de transcrição ───────────────────────────────────────────────────
# "assemblyai" (padrão) ou "deepgram". Só troque com o relatório da comparação
# na mão:
#   cd backend && .venv/bin/python -m app.scripts.compare_transcribers <job_id>
TRANSCRIPTION_PROVIDER=assemblyai

# Deepgram — alternativa em avaliação. Sem a chave, o provedor simplesmente não
# fica disponível e a comparação avisa que ele foi pulado.
DEEPGRAM_API_KEY=
# nova-3 atende português direto (pt, pt-BR) no modelo monolíngue.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=pt

# Tarifas para a ESTIMATIVA de custo do relatório, em USD por hora de áudio.
# Tabela pay-as-you-go consultada em 25/08/2026 — confira antes de decidir por
# elas. AssemblyAI universal-3-pro: 0.21/h. Deepgram nova-3 mono: 0.258/h
# (0.0043/min), ou seja, ~23% MAIS CARO que o padrão atual.
ASSEMBLYAI_COST_PER_HOUR=0.21
DEEPGRAM_COST_PER_HOUR=0.258

# Pós-processamento local do vídeo bruto (upscale → interpolação → reencode).
ENHANCE_TARGET_HEIGHT=1080
ENHANCE_TARGET_FPS=24
ENHANCE_VIDEO_BITRATE=12M
