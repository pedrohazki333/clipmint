# AssemblyAI
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=8192

# Porta do backend. O Makefile e o proxy do frontend leem daqui, então trocar
# neste arquivo basta — não existe segunda cópia para manter em sincronia.
# Fica fora da 8000 de propósito: é a porta padrão de todo projeto FastAPI, e
# um vizinho ocupando ela faz o proxy do frontend cair na API errada.
BACKEND_PORT=8001

# Storage
STORAGE_DIR=./storage

# Database
SQLITE_URL=sqlite+aiosqlite:///./clipmint.db

# Pipeline settings
VIRALITY_THRESHOLD=7.0
MAX_CLIP_DURATION=90
MIN_CLIP_DURATION=15

# Face tracking: true = crop 9:16 segue o rosto; false = crop fixo no centro
FACE_TRACKING_ENABLED=false

# Modo streamer (facecam + gameplay): largura da saída vertical.
# 1080 = Full HD (1080x1920). 2160 gera 4K vertical — arquivo e tempo de render
# muito maiores, só compensa com fonte 1440p+.
STREAMER_OUTPUT_WIDTH=1080

# Zoom da fatia de gameplay. 1.0 = altura cheia da fonte; acima disso fecha o
# enquadramento e afasta a fatia da moldura da facecam.
STREAMER_GAME_ZOOM=1.06

# Marca d'água do clipe: a arte de storage/branding/<nicho>/clip_watermark.png,
# queimada no modo streamer. Largura e altura em frações do canvas; a altura é o
# CENTRO da arte, não o topo. Conta sem o arquivo não ganha marca nenhuma.
CLIP_WATERMARK_WIDTH=0.185
CLIP_WATERMARK_CENTER_Y=0.794
CLIP_WATERMARK_OPACITY=0.70

# Nitidez da facecam depois da ampliação (a cam da fonte é pequena e sobe ~2x).
# 0 desliga; acima de ~1.2 começa a marcar halo em óculos e contorno do cabelo.
FACECAM_SHARPEN=0.8

# Acesso remoto: senha da tela de login do frontend e token da API (header
# X-ClipMint-Token). Vazia = sem checagem, só para uso local.
CLIPMINT_PASSWORD=

# AssemblyAI: modelo de fala. universal-2 (antigo, barato), universal-3-pro,
# universal-3-5-pro (melhor em gíria/grito/áudio sujo). Vazio em LANGUAGE = autodetectar.
ASSEMBLYAI_SPEECH_MODEL=universal-3-pro
ASSEMBLYAI_LANGUAGE=pt

# Pós-processamento local do vídeo bruto (upscale → interpolação → reencode).
ENHANCE_TARGET_HEIGHT=1080
ENHANCE_TARGET_FPS=24
ENHANCE_VIDEO_BITRATE=12M
